{
  "DiskMon": {
    "DataDirectory": "%ProgramData%\\DiskMon",
    "Volumes": [ "C:" ],
    "Intervals": {
      "VolumeSampleSeconds": 30,
      "ProcessIoSampleSeconds": 60,
      "ProbeRunMinutes": 10,
      "ProbeTimeoutSeconds": 60
    },
    "Swing": {
      "ThresholdGb": 1,
      "WindowMinutes": 15,
      "MaxDurationMinutes": 120,
      "MinItemMb": 50
    },
    "TopWriters": {
      "Count": 10,
      "MinWriteMb": 1
    },
    "Retention": {
      "SampleDays": 30
    },
    "Tray": {
      "RedBelowPercent": 5,
      "RedBelowGb": 10,
      "AmberBelowPercent": 10,
      "AmberBelowGb": 20
    },
    "Probes": [
      { "Name": "Windows Update downloads", "Kind": "Dir", "Path": "C:\\Windows\\SoftwareDistribution\\Download" },
      { "Name": "Windows Temp", "Kind": "Dir", "Path": "C:\\Windows\\Temp" },
      { "Name": "Live kernel reports", "Kind": "Dir", "Path": "C:\\Windows\\LiveKernelReports" },
      { "Name": "Minidumps", "Kind": "Dir", "Path": "C:\\Windows\\Minidump" },
      { "Name": "Memory dump", "Kind": "File", "Path": "C:\\Windows\\MEMORY.DMP" },
      { "Name": "Delivery Optimization", "Kind": "Dir", "Path": "C:\\ProgramData\\Microsoft\\Windows\\DeliveryOptimization" },
      { "Name": "Windows upgrade staging", "Kind": "Dir", "Path": "C:\\$WINDOWS.~BT" },
      { "Name": "Windows RE agent", "Kind": "Dir", "Path": "C:\\$WinREAgent" },
      { "Name": "Recycle Bin", "Kind": "Dir", "Path": "C:\\$Recycle.Bin" },
      { "Name": "Windows logs", "Kind": "Dir", "Path": "C:\\Windows\\Logs" },
      { "Name": "Windows Installer cache", "Kind": "Dir", "Path": "C:\\Windows\\Installer" },
      { "Name": "Page file", "Kind": "File", "Path": "C:\\pagefile.sys" },
      { "Name": "Hibernation file", "Kind": "File", "Path": "C:\\hiberfil.sys" },
      { "Name": "Swap file", "Kind": "File", "Path": "C:\\swapfile.sys" },
      { "Name": "VSS shadow storage", "Kind": "Vss", "Path": "C:" },

      { "Name": "User Temp", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\Temp" },
      { "Name": "Crash dumps", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\CrashDumps" },
      { "Name": "Chrome", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\Google\\Chrome\\User Data" },
      { "Name": "Edge", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\Microsoft\\Edge\\User Data" },
      { "Name": "Docker", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\Docker" },
      { "Name": "WSL disks", "Kind": "Glob", "Path": "{user}\\AppData\\Local\\Packages\\*CanonicalGroup*\\LocalState" },
      { "Name": "npm cache", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\npm-cache" },
      { "Name": "pnpm store", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\pnpm" },
      { "Name": "Yarn cache", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\Yarn" },
      { "Name": "pip cache", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\pip\\Cache" },
      { "Name": "Gradle", "Kind": "Dir", "Path": "{user}\\.gradle" },
      { "Name": "Maven", "Kind": "Dir", "Path": "{user}\\.m2" },
      { "Name": "NuGet packages", "Kind": "Dir", "Path": "{user}\\.nuget\\packages" },
      { "Name": "VS Code", "Kind": "Dir", "Path": "{user}\\AppData\\Roaming\\Code" },
      { "Name": "Cursor", "Kind": "Dir", "Path": "{user}\\AppData\\Roaming\\Cursor" },
      { "Name": "JetBrains", "Kind": "Dir", "Path": "{user}\\AppData\\Local\\JetBrains" },
      { "Name": "Downloads", "Kind": "Dir", "Path": "{user}\\Downloads" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
